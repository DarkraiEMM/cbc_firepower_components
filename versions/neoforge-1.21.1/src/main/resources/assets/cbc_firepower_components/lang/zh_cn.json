    "cbc_firepower_components.ponder.single_large_autocannon.text_1": "从大型机炮炮闩开始组装",
    "cbc_firepower_components.ponder.single_large_autocannon.text_2": "沿同一直线继续连接炮管",
    "cbc_firepower_components.ponder.single_large_autocannon.text_3": "制退器会降低后坐力，并缩短可见的后坐行程",
    "cbc_firepower_components.ponder.single_large_autocannon.text_4": "向炮闩输入穿甲弹或高爆弹",
    "cbc_firepower_components.ponder.single_large_autocannon.text_5": "炮弹从炮口射出，同时炮管完成一次短促的后坐复进",
    "cbc_firepower_components.ponder.twin_large_autocannon.header": "使用双联大型机炮",
    "cbc_firepower_components.ponder.twin_large_autocannon.text_1": "双联部件会形成两条平行的发射通道",
    "cbc_firepower_components.ponder.twin_large_autocannon.text_2": "左右炮管交替开火，不会让两发炮弹都从同一根炮管射出",
    "cbc_firepower_components.ponder.twin_large_autocannon.text_3": "每发炮弹从对应炮口生成，并只带动对应炮管后坐复进",
    "cbc_firepower_components.ponder.autocannon_feed.header": "为大型机炮供弹",
    "cbc_firepower_components.ponder.autocannon_feed.text_1": "大型机炮弹药箱用于存放散装机炮弹",
    "cbc_firepower_components.ponder.autocannon_feed.text_2": "让供弹路径从弹药箱指向炮闩",
    "cbc_firepower_components.ponder.autocannon_feed.text_3": "穿甲弹和高爆弹可以共用同一套供弹系统",
    "cbc_firepower_components.ponder.autocannon_feed.text_4": "弹药箱每次只消耗一个物品，整组堆叠不会被当作一个超大弹匣装入",
    "cbc_firepower_components.ponder.magazine_loader.header": "准备完整火炮弹药",
    "cbc_firepower_components.ponder.magazine_loader.text_1": "火炮弹匣装填器在弹药抵达火炮前完成配组",
    "cbc_firepower_components.ponder.magazine_loader.text_2": "先放入一枚兼容弹头",
    "cbc_firepower_components.ponder.magazine_loader.text_3": "再放入与其匹配的发射药",
    "cbc_firepower_components.ponder.magazine_loader.text_4": "完成配组的弹药可以继续送往火炮",
    "cbc_firepower_components.ponder.ready_compartment.header": "使用智能待发弹药舱",
    "cbc_firepower_components.ponder.ready_compartment.text_1": "每个仓位表示一套完整发射弹，而不是一组散装零件",
    "cbc_firepower_components.ponder.ready_compartment.text_2": "新弹药从当前队尾顺延装入，不会反复从首格开始",
    "cbc_firepower_components.ponder.ready_compartment.text_3": "首个仓位取空后，其余队列会自动向前进位",
    "cbc_firepower_components.ponder.ready_compartment.text_4": "机械臂和普通物流都能输入或取出整套发射弹",
    "cbc_firepower_components.ponder.ready_compartment.text_5": "输出口朝向受支持炮座时可直接供弹，三发火炮弹匣不是刚需",
    "cbc_firepower_components.ponder.ready_compartment.text_6": "打开界面可以查看并手动调整弹药队列",
    "cbc_firepower_components.ponder.carousel_ammunition_rack.header": "使用转盘式待发弹药架",
    "cbc_firepower_components.ponder.carousel_ammunition_rack.text_1": "转盘占据居中的 3×3 空间，可存放 24 套完整弹药",
    "cbc_firepower_components.ponder.carousel_ammunition_rack.text_2": "弹药沿转盘外圈水平躺放",
    "cbc_firepower_components.ponder.carousel_ammunition_rack.text_3": "贴近炮座的一侧会成为出弹口",
    "cbc_firepower_components.ponder.carousel_ammunition_rack.text_4": "出弹口的弹药被取走后，下一处有弹仓位会自动进位",
    "cbc_firepower_components.ponder.carousel_ammunition_rack.text_5": "可在界面交换弹位，也可空手取回出弹口的弹药",
    "cbc_firepower_components.ponder.spent_casing_collector.header": "回收空药筒",
    "cbc_firepower_components.ponder.spent_casing_collector.text_1": "回收器会收集周围范围内受支持的空弹壳和空药筒",
    "cbc_firepower_components.ponder.spent_casing_collector.text_2": "从筒口向下看，可以看到内部逐渐堆积的弹壳",
    "cbc_firepower_components.ponder.spent_casing_collector.text_3": "弹壳接近筒口时表示回收器即将装满",
    "cbc_firepower_components.ponder.spent_casing_collector.text_4": "机械臂和其他物流设备可以取出回收物",
    "cbc_firepower_components.ponder.automatic_cannon_controller.header": "同时控制多门火炮",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_1": "短按右键会发送一次开火指令",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_2": "按住右键打开机械动力风格的模式切换界面",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_3": "在一组切换项中选择单发、三发点射或连续射击",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_4": "另一组切换项选择轮询或齐射；轮询逐门前进，齐射同时触发",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_5": "潜行右键选择下一种待发弹药",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_6": "背面红石信号的上升沿等价于一次短按右键",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_7": "绑定炮座和待发弹药设备，无需给不同信号面分配不同职责",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_8": "点射和连续射击会保留被控机炮自身可用的射速",
    "cbc_firepower_components.ponder.automatic_cannon_controller.text_9": "普通红石始终可用；Drive By Wire 只是可选的无线升级",
    "cbc_firepower_components.ponder.cannon_limiter.header": "限制火炮活动范围",
    "cbc_firepower_components.ponder.cannon_limiter.text_1": "对紧凑型炮座使用限制器，以设置安全的瞄准范围",
    "cbc_firepower_components.ponder.cannon_limiter.text_2": "设定的俯仰与水平限制会阻止火炮越出所选扇区",
    "cbc_firepower_components.ponder.cannon_limiter.text_3": "潜行右键炮座可取下已经安装的限制器",
    "cbc_firepower_components.ponder.spyglass_rangefinding.header": "使用望远镜测距",
    "cbc_firepower_components.ponder.spyglass_rangefinding.text_1": "使用望远镜观察时，按下已绑定的测距按键",
    "cbc_firepower_components.ponder.spyglass_rangefinding.text_2": "结果是视线命中最近碰撞点的实际直线距离",
    "cbc_firepower_components.ponder.spyglass_rangefinding.text_3": "测距不会识别、锁定或保存目标",
    "cbc_firepower_components.ponder.spyglass_rangefinding.text_4": "跨航空学物理体测量时使用实际世界空间位置，而不是直接相减局部坐标"
}
